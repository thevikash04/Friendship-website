/* =====================================
   GRAND FIREWORKS
===================================== */

function launchFinalFireworks(){

if(typeof confetti!=="function") return;

let duration=5000;

let end=Date.now()+duration;

(function frame(){

confetti({
particleCount:12,
spread:100,
origin:{x:Math.random(),y:Math.random()*0.6}
});

if(Date.now()<end){
requestAnimationFrame(frame);
}

})();

}

