// ===== Elements =====

const loading = document.getElementById("loading");
const home = document.getElementById("home");
const openBtn = document.getElementById("openBtn");

const envelopeSection = document.getElementById("envelopeSection");
const envelope = document.querySelector(".envelope");

const gallery = document.getElementById("gallery");
const finalPage = document.getElementById("final");

const typing = document.getElementById("typing");
const next = document.getElementById("next");

const slide = document.getElementById("slide");

const music = document.getElementById("music");
const musicBtn = document.getElementById("musicBtn");

// ===== Loading =====

window.onload = () => {

setTimeout(() => {

loading.style.display = "none";

home.style.display = "flex";

},2500);

};

// ===== Open Surprise =====

openBtn.onclick = () => {

home.style.display = "none";

envelopeSection.style.display = "flex";

};

// ===== Letter =====

const pages = [

`Sometimes life gives us unexpected gifts...

and you are one of mine. 💛`,

`Thank you for every random chat,

every smile,

every laugh,

every memory.

You make ordinary days special. ✨`,

`I don't know what the future holds,

but I hope one thing never changes...

our friendship. ❤️`,

`Dear Gulul,

Thank you for always being yourself.

Thank you for every beautiful memory.

Happy Friendship Day 💛

— Vikash`

];

let page = 0;

// ===== Envelope Open =====

envelope.onclick = () => {

envelope.classList.add("open");

setTimeout(()=>{

typeWriter(pages[page]);

},900);

};

// ===== Typewriter =====

function typeWriter(text){

typing.innerHTML="";

let i=0;

function type(){

if(i<text.length){

typing.innerHTML += text.charAt(i);

i++;

setTimeout(type,35);

}

}

type();

}

// ===== Next Button =====

next.onclick = ()=>{

page++;

if(page<pages.length){

typeWriter(pages[page]);

}

else{

envelopeSection.style.display="none";

gallery.style.display="flex";

startSlider();

}

};

// ===== Photo Slider =====

const photos=[

"images/pic1.jpg",

"images/pic2.jpg"

];

let current=0;

function startSlider(){

setInterval(()=>{

current++;

if(current>=photos.length){

current=0;

}

slide.src=photos[current];

},2500);

// 8 sec later Final Page

setTimeout(()=>{

gallery.style.display="none";

finalPage.style.display="flex";

fireworks();

},8000);

}

// ===== Fireworks =====

function fireworks(){

if(typeof confetti==="function"){

let duration=5000;

let end=Date.now()+duration;

(function frame(){

confetti({

particleCount:6,

angle:60,

spread:70,

origin:{x:0}

});

confetti({

particleCount:6,

angle:120,

spread:70,

origin:{x:1}

});

if(Date.now()<end){

requestAnimationFrame(frame);

}

})();

}

}

// ===== Music =====

musicBtn.onclick=()=>{

if(music.paused){

music.play();

musicBtn.innerHTML="⏸️";

}

else{

music.pause();

musicBtn.innerHTML="🎵";

}

};
